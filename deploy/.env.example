# Copy to deploy/.env and fill in. Never commit .env.

# The site's domain; its DNS A (and AAAA) record must point at this server.
DOMAIN=critters.example.com

# Database password, letters and digits only (it goes in a URL): `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# healthchecks.io (or similar) check URLs, pinged by the daily update and the nightly
# backup; each emails you when its job fails or doesn't run. Leave empty to skip.
HEALTHCHECK_UPDATE_URL=
HEALTHCHECK_BACKUP_URL=

# Where backups go: an rclone remote and path (see `rclone config`), e.g. b2:critters-backups.
# Leave empty to keep backups on this server only.
BACKUP_REMOTE=
# Days of backups to keep, locally and on the remote.
BACKUP_KEEP_DAYS=30

# For a local rehearsal only: other ports, and plain-HTTP cookies.
# HTTP_PORT=8080
# HTTPS_PORT=8443
# CRITTERS_SECURE_COOKIE=0
